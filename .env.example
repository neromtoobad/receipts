# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- the forecast model: ONE of these ---
# Google AI Studio (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# The default is local via Ollama: no key, no rate limit, no daily cap, and the
# deletion test reproduces without an account anywhere. Run `ollama serve` and
# `ollama pull qwen2.5:7b-instruct`, and the two lines below are all you need.
#
# Hosted free tiers are not viable for this bench: it makes ~3000 model calls,
# and the tiers we tried cap at 20 requests/day (Google) or 20k tokens/day
# (AionLabs). A bench pointed at an exhausted endpoint does not fail loudly —
# it stalls at 30s per call and never finishes.
RECEIPTS_OPENAI_BASE_URL=http://localhost:11434/v1

# Which model the bench and the league use. Every arm must use the SAME one.
RECEIPTS_BENCH_MODEL=qwen2.5:7b-instruct

# Any other OpenAI-compatible provider (OpenRouter, Together, a hosted server)
# works by replacing the base URL above and setting its key here.
# OPENAI_API_KEY=
RECEIPTS_LIVE_MODEL=gemini-flash-latest

# --- the wallet: written by ./scripts/new_wallet.sh, testnet only ---
# RECEIPTS_MASTER_SEED=
# EVIDENCE_PAY_TO=
